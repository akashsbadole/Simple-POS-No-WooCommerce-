<?xml version="1.0"?>
<ruleset name="Simple POS">
	<description>WordPress.org ready ruleset - PHP only; vendor, assets and tests excluded.</description>
	<file>.</file>
	<arg name="extensions" value="php"/>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/.opencode/*</exclude-pattern>
	<exclude-pattern>*/admin/js/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*.js</exclude-pattern>
	<exclude-pattern>*.css</exclude-pattern>
	<exclude-pattern>*/benchmarks/*</exclude-pattern>
	<exclude-pattern>**/.kilo/**</exclude-pattern>
	<exclude-pattern>**/.git/**</exclude-pattern>
	<exclude-pattern>**/.github/**</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/release/*</exclude-pattern>
	<rule ref="WordPress"/>
	<rule ref="PluginCheck"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="simple-pos"/>
			</property>
		</properties>
	</rule>
	<!-- View templates are included inside render methods, so their locals are
	     function-scoped, not globals. Prefix check is a known false positive there. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="simple_pos"/>
				<element value="Simple_POS"/>
				<element value="SIMPLE_POS"/>
			</property>
		</properties>
	</rule>
	<config name="minimum_supported_wp_version" value="5.8"/>
	<arg name="colors"/>
	<arg value="np"/>
</ruleset>
