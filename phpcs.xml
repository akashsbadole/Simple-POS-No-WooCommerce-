<?xml version="1.0"?>
<ruleset name="Simple POS">
	<description>WordPress.org ready ruleset — vendor directory excluded.</description>
	<file>.</file>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/.opencode/*</exclude-pattern>
	<exclude-pattern>*/admin/js/vendor/*</exclude-pattern>
	<exclude-pattern>*/benchmarks/*</exclude-pattern>
	<exclude-pattern>**/.kilo/**</exclude-pattern>
	<exclude-pattern>**/.git/**</exclude-pattern>
	<exclude-pattern>**/.github/**</exclude-pattern>
	<rule ref="WordPress"/>
	<rule ref="PluginCheck"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="wp-pos-plugin"/>
		</properties>
	</rule>
	<config name="minimum_supported_wp_version" value="5.8"/>
	<arg name="colors"/>
	<arg value="np"/>
</ruleset>
